# Copy to keystore.properties (gitignored) and fill in. storeFile must point
# outside this repository. The same names work as environment variables with
# an HYPERTROPHY_ prefix: HYPERTROPHY_STORE_FILE, HYPERTROPHY_STORE_PASSWORD,
# HYPERTROPHY_KEY_ALIAS, HYPERTROPHY_KEY_PASSWORD. Environment values win.
storeFile=/absolute/path/to/hypertrophy-release.jks
storePassword=
keyAlias=
keyPassword=
