<?xml version="1.0" encoding="utf-8"?>
<!--
    Platform Auto Backup is off. It copies the database without a WAL checkpoint
    and would upload physique photos. Backup goes through the in-app archive.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
